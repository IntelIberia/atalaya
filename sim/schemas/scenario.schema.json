{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atalaya.invalid/sim/scenario.schema.json",
  "title": "Escenario del simulador de Atalaya (T1.9, REQ-FUN-005)",
  "description": "Escenario sintético. Los centros son ficticios (D-8) y se redondean a 0,01°; todo lo demás se expresa como desplazamiento local en metros respecto al centro de su emplazamiento. launch_point equivale al origen probable y es FCSE_ONLY (REQ-LEG-007).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "seed_policy",
    "duration_s",
    "geometry",
    "environment",
    "sites",
    "threats",
    "manned_aircraft",
    "faults"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_seed", "derivation"],
      "properties": {
        "default_seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "derivation": { "const": "sha256-component" }
      }
    },
    "duration_s": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "geometry": { "type": "string", "pattern": "^[a-z0-9_]+\\.nodes\\.geo\\.json$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature_c", "relative_humidity_pct", "wind", "background_bands"],
      "properties": {
        "temperature_c": { "type": "number", "minimum": -30, "maximum": 55 },
        "relative_humidity_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "wind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speed_mps", "from_deg"],
          "properties": {
            "speed_mps": { "type": "number", "minimum": 0, "maximum": 40 },
            "from_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
          }
        },
        "background_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center_hz", "level_db_spl"],
            "properties": {
              "center_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 24000 },
              "level_db_spl": { "type": "number", "minimum": 0, "maximum": 120 }
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "center", "objectives"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "center": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lat_deg", "lon_deg"],
            "properties": {
              "lat_deg": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon_deg": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "offset_m", "radius_m"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "kind": { "enum": ["perimeter", "point"] },
                "offset_m": { "$ref": "#/$defs/offset" },
                "radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 }
              }
            }
          }
        }
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "site", "start_s", "speed_mps", "route", "remote_id", "launch_point"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "class": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
          "site": { "$ref": "#/$defs/identifier" },
          "start_s": { "type": "number", "minimum": 0 },
          "speed_mps": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
          "route": { "$ref": "#/$defs/route" },
          "remote_id": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["none", "compliant", "forged"] },
              "standard": { "enum": ["EN_4709_002", "ASTM_F3411"] }
            },
            "if": { "properties": { "mode": { "const": "none" } } },
            "then": { "not": { "required": ["standard"] } },
            "else": { "required": ["standard"] }
          },
          "launch_point": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sensitivity", "offset_m"],
            "properties": {
              "sensitivity": { "const": "FCSE_ONLY" },
              "offset_m": { "$ref": "#/$defs/offset" }
            }
          }
        }
      }
    },
    "manned_aircraft": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "site", "start_s", "speed_mps", "route"],
        "properties": {
          "id": { "type": "string", "pattern": "^SIM[0-9A-Z]{2,5}$" },
          "class": { "const": "C8" },
          "site": { "$ref": "#/$defs/identifier" },
          "start_s": { "type": "number", "minimum": 0 },
          "speed_mps": { "type": "number", "minimum": 20, "maximum": 300 },
          "route": { "$ref": "#/$defs/route" }
        }
      }
    },
    "faults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "node", "start_s", "duration_s"],
        "properties": {
          "kind": {
            "enum": ["node_down", "pps_invalid", "clock_drift", "latency", "packet_loss", "duplicate", "reorder"]
          },
          "node": { "$ref": "#/$defs/identifier" },
          "start_s": { "type": "number", "minimum": 0 },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "magnitude": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$" },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["east_m", "north_m", "up_m"],
      "properties": {
        "east_m": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "north_m": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "up_m": { "type": "number", "minimum": -100, "maximum": 12000 }
      }
    },
    "route": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/offset" }
    }
  }
}
